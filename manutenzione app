<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Pellet Helper Mobile</title>

<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
body {
    font-family: Arial, sans-serif;
    max-width: 700px;
    margin: auto;
    padding: 20px;
    background-color: #f7f7f7;
    color: #333;
}
header, footer { text-align: center; margin-bottom: 20px; }
h1 { color: #2c3e50; }
input, button { padding: 10px; font-size: 16px; margin-top: 8px; width: 100%; box-sizing: border-box; }
button { background-color: #27ae60; color: white; border: none; cursor: pointer; margin-top: 15px; transition: background-color 0.3s ease; }
button:hover { background-color: #2ecc71; }
.result { margin-top: 20px; font-weight: bold; font-size: 18px; }
section { background-color: white; padding: 20px; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.1); margin-bottom: 20px; }
label { margin-top: 10px; display: block; }
.affiliate-links a { display: inline-block; margin: 5px 0; padding: 10px; background-color: #ff9900; color: white; text-decoration: none; border-radius: 5px; }
.affiliate-links a:hover { background-color: #e68a00; }
canvas { margin-top: 20px; }
.agent { background-color: #ecf0f1; padding: 15px; border-radius: 5px; margin-top: 15px; }
</style>
</head>
<body>

<header>
<h1>AI Pellet Helper Mobile</h1>
</header>

<main>

<!-- Calcolatore -->
<section>
<label for="price">Prezzo di un sacco (€)</label>
<input type="number" id="price" placeholder="Es. 5.50" step="0.01">

<label for="bags">Sacchi consumati al mese</label>
<input type="number" id="bags" placeholder="Es. 10">

<button id="calculateBtn">Calcola spesa</button>

<div class="result" id="result"></div>

<canvas id="costChart" width="400" height="200"></canvas>

<div class="agent" id="agent">💡 AI Consiglio: Inserisci i dati per ricevere suggerimenti!</div>
</section>

<!-- Link affiliati -->
<section>
<h2>Acquista Pellet su Amazon</h2>
<div class="affiliate-links">
<a href="https://amzn.to/3N2jVQs" target="_blank">Pellet Opzione 1</a>
<a href="https://amzn.to/4rOvYQk" target="_blank">Pellet Opzione 2</a>
<a href="https://amzn.to/4rDA8KQ" target="_blank">Pellet Opzione 3</a>
</div>
</section>

</main>

<footer>
<p>&copy; 2026 AI Pellet Helper Mobile</p>
</footer>

<script>
const ctx = document.getElementById('costChart').getContext('2d');
let chart;

document.getElementById("calculateBtn").addEventListener("click", function() {
    const price = parseFloat(document.getElementById("price").value);
    const bags = parseFloat(document.getElementById("bags").value);

    if (isNaN(price) || isNaN(bags) || price <= 0 || bags <= 0) {
        document.getElementById("result").innerText = "Inserisci valori validi maggiori di zero!";
        return;
    }

    const monthly = price * bags;
    const yearly = monthly * 12;

    document.getElementById("result").innerHTML =
        `Spesa mensile stimata: € ${monthly.toFixed(2)}<br>` +
        `Spesa annuale stimata: € ${yearly.toFixed(2)}`;

    // Aggiorna grafico
    if (chart) chart.destroy();
    chart = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: ['Mensile', 'Annuale'],
            datasets: [{
                label: 'Spesa (€)',
                data: [monthly, yearly],
                backgroundColor: ['#27ae60', '#2c3e50']
            }]
        },
        options: {
            responsive: true,
            scales: {
                y: { beginAtZero: true }
            }
        }
    });

    // AI Agent simulato (offline)
    let advice = "";
    if (bags > 15) {
        advice = "💡 Consiglio: Stai consumando molti sacchi. Valuta di ottimizzare il riscaldamento!";
    } else if (price > 6) {
        advice = "💡 Consiglio: Il prezzo del sacco è alto. Controlla offerte su Amazon!";
    } else {
        advice = "💡 Consiglio: Ottimo! Il tuo consumo e prezzo sono nella media.";
    }
    document.getElementById("agent").innerText = advice;
});
</script>

</body>
</html>